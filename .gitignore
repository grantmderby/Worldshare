# Build output
build/
out/
*.class

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Forge runtime directories
# run2/ and run3/ are the second and third dev clients (see the runs block in
# build.gradle). Each is a full game directory holding OAuth tokens, so they must
# stay out of git as firmly as run/ does.
run/
run2/
run3/
run-data/
runs/

# ForgeGradle generated files
src/generated/

# IDE files - IntelliJ
.idea/
*.iml
*.iws
*.ipr

# IDE files - Eclipse
.classpath
.project
.settings/
bin/

# IDE files - VS Code
.vscode/
.factorypath

# OS files
.DS_Store
Thumbs.db

# Credentials — critically important to never commit.
# The mod stores Google Drive OAuth tokens here; they must stay local.
credentials/
*.token
*.refresh-token
worldshare-credentials.json

